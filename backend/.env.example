# Backend environment variables
# Copy this to .env and fill in real values

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database (PostgreSQL via Neon, Supabase, or Render Postgres) ────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# ─── JWT Secrets (use strong random strings, min 32 chars) ──────────
JWT_ACCESS_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_min_32_chars
JWT_RESET_SECRET=replace_with_reset_token_secret_min_32_chars

# ─── Frontend URL (for CORS and Socket.IO) ──────────────────────────
CLIENT_URL=https://your-app.vercel.app

# ─── Optional: Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Optional: Cloudinary (file uploads) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
