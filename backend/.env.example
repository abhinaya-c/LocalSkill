# Backend environment variables
# Copy this to .env and fill in real values

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Supabase Database ───────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → Database → Connection String

# 1. POOLED connection (Transaction mode, port 6543) — used by Prisma Client at runtime
#    Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# 2. DIRECT connection (port 5432) — used only by prisma migrate
#    Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── JWT Secrets (use strong random strings, min 32 chars) ──────────
# Generate with: openssl rand -base64 40
JWT_ACCESS_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_min_32_chars
JWT_RESET_SECRET=replace_with_reset_token_secret_min_32_chars

# ─── Frontend URL (for CORS and Socket.IO) ──────────────────────────
CLIENT_URL=https://your-app.vercel.app

# ─── Optional: Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Optional: Cloudinary (file uploads) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
