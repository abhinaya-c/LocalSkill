# Frontend environment variables (for Vercel)
# Prefix ALL variables with VITE_ to expose them to the browser build

# ─── Backend API URL (your Render backend URL, NO trailing slash) ────
VITE_API_URL=https://localskill-backend.onrender.com

# ─── Optional: Google Maps (if using map features) ──────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
